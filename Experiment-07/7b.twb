      <column caption='Stock Price Category' datatype='string' name='[Calculation_1104500486246401]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [stock_price] &gt;= 500 THEN &quot;High&quot;&#13;&#10;ELSEIF [stock_price] &gt;= 100 THEN &quot;Medium&quot;&#13;&#10;ELSE &quot;Low&quot;&#13;&#10;END' />
      </column>
      <column caption='Price Selection' datatype='boolean' name='[Calculation_1104500488044546]' role='dimension' type='nominal'>
