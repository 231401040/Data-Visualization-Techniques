      <column caption='Transaction Category' datatype='string' name='[Calculation_1104500485558272]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [transaction] = &quot;Purchase&quot; THEN &quot;Purchase&quot;&#13;&#10;ELSEIF CONTAINS([transaction], &quot;Sale&quot;) THEN &quot;Sale&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
