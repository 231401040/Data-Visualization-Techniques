    <worksheet name='Risk Breakdown'>
      <table>
        <view>
          <datasources>
            <datasource caption='healthcare (healthcareDB)' name='federated.1dodda30jhn0yw198lkb41qh51xz' />
          </datasources>
          <datasource-dependencies datasource='federated.1dodda30jhn0yw198lkb41qh51xz'>
            <column caption='Risk Flag' datatype='string' name='[Calculation_1268881554812929]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [length_of_stay] &gt; 20 AND [test_results] = &quot;Abnormal&quot; THEN &quot;High Risk&quot;&#13;&#10;ELSEIF [test_results] = &quot;Abnormal&quot; THEN &quot;Monitor&quot;&#13;&#10;ELSE &quot;Normal&quot;&#13;&#10;END' />
            </column>
            <column caption='First Admission' datatype='date' name='[Calculation_1268881554923522]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [name] : MIN([date_of_admission]) }' />
            </column>
            <column caption='Patient Type' datatype='string' name='[Calculation_1268881554980867]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date_of_admission] = [Calculation_1268881554923522] THEN &quot;New Patient&quot;&#13;&#10;ELSE &quot;Returning Patient&quot;&#13;&#10;END' />
            </column>
            <column-instance column='[name]' derivation='CountD' name='[ctd:name:qk]' pivot='key' type='quantitative' />
