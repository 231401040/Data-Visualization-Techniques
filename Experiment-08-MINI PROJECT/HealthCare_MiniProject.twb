              <flipboard active-id='1' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Overall performance: 54,966 admissions, ₹140.4 crore total billing' captured-sheet='Dashboard 1' id='1' />
                  <story-point caption='Paediatric admissions (0-18) are minimal — under 200 patients per condition versus ~3,000 in other age bands' captured-sheet='Condition Age Heatmap' id='2' />
                  <story-point caption='Risk classification is independent of patient history — New and Returning patients split consistently across all three risk tiers' captured-sheet='Risk Breakdown' id='3' />
                  <story-point caption='Billing is evenly distributed across insurers — Cigna leads at ₹28.4 crore, only 2.8% above Aetna' captured-sheet='Insurance Treemap' id='4' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
