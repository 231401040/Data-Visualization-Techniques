      <aliases enabled='yes' />
      <column caption='Cost per Day' datatype='real' name='[Calculation_1268881554714624]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([billing_amount]) / SUM([length_of_stay])' />
      </column>
      <column caption='Risk Flag' datatype='string' name='[Calculation_1268881554812929]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [length_of_stay] &gt; 20 AND [test_results] = &quot;Abnormal&quot; THEN &quot;High Risk&quot;&#13;&#10;ELSEIF [test_results] = &quot;Abnormal&quot; THEN &quot;Monitor&quot;&#13;&#10;ELSE &quot;Normal&quot;&#13;&#10;END' />
      </column>
      <column caption='First Admission' datatype='date' name='[Calculation_1268881554923522]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [name] : MIN([date_of_admission]) }' />
      </column>
      <column caption='Patient Type' datatype='string' name='[Calculation_1268881554980867]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [date_of_admission] = [Calculation_1268881554923522] THEN &quot;New Patient&quot;&#13;&#10;ELSE &quot;Returning Patient&quot;&#13;&#10;END' />
      </column>
      <column caption='Emergency Rate' datatype='real' name='[Calculation_1268881555013636]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [admission_type] = &quot;Emergency&quot; THEN 1 ELSE 0 END) / COUNT([name])' />
      </column>
      <column caption='Dynamic Measure' datatype='real' name='[Calculation_1268881556082695]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Total Billing&quot; THEN SUM([billing_amount])&#13;&#10;WHEN &quot;Average Stay&quot; THEN AVG([length_of_stay])&#13;&#10;WHEN &quot;Patient Count&quot; THEN COUNTD([name])&#13;&#10;END' />
      </column>
      <column caption='Dynamic Date' datatype='datetime' name='[Calculation_1268881556299784]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &quot;Month&quot; THEN DATETRUNC(&apos;month&apos;, [date_of_admission])&#13;&#10;WHEN &quot;Quarter&quot; THEN DATETRUNC(&apos;quarter&apos;, [date_of_admission])&#13;&#10;WHEN &quot;Year&quot; THEN DATETRUNC(&apos;year&apos;, [date_of_admission])&#13;&#10;END' />
      </column>
