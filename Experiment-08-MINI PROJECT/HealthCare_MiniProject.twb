    <worksheet name='Top Conditions By Billing'>
      <table>
        <view>
          <datasources>
            <datasource caption='healthcare (healthcareDB)' name='federated.1dodda30jhn0yw198lkb41qh51xz' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Top N Conditions' datatype='integer' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='5'>
              <calculation class='tableau' formula='5' />
              <range granularity='1' max='15' min='3' />
            </column>
            <column caption='Select Measure' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total Billing&quot;'>
              <calculation class='tableau' formula='&quot;Total Billing&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1dodda30jhn0yw198lkb41qh51xz'>
            <column caption='Dynamic Measure' datatype='real' name='[Calculation_1268881556082695]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Total Billing&quot; THEN SUM([billing_amount])&#13;&#10;WHEN &quot;Average Stay&quot; THEN AVG([length_of_stay])&#13;&#10;WHEN &quot;Patient Count&quot; THEN COUNTD([name])&#13;&#10;END' />
            </column>
            <column caption='Billing Amount' datatype='real' name='[billing_amount]' role='measure' type='quantitative' />
            <column caption='Length Of Stay' datatype='integer' name='[length_of_stay]' role='measure' type='quantitative' />
            <column caption='Medical Condition' datatype='string' name='[medical_condition]' role='dimension' type='nominal' />
            <column caption='Name' datatype='string' name='[name]' role='dimension' type='nominal' />
            <column-instance column='[medical_condition]' derivation='None' name='[none:medical_condition:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1268881556082695]' derivation='User' name='[usr:Calculation_1268881556082695:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1dodda30jhn0yw198lkb41qh51xz].[none:medical_condition:nk]'>
            <groupfilter count='[Parameters].[Parameter 1]' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='SUM([billing_amount])' function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:medical_condition:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
              </groupfilter>
            </groupfilter>
          </filter>
          <shelf-sorts>
            <shelf-sort-v2 dimension-to-sort='[federated.1dodda30jhn0yw198lkb41qh51xz].[none:medical_condition:nk]' direction='DESC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.1dodda30jhn0yw198lkb41qh51xz].[usr:Calculation_1268881556082695:qk]' shelf='rows' />
          </shelf-sorts>
          <slices>
            <column>[federated.1dodda30jhn0yw198lkb41qh51xz].[none:medical_condition:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <color column='[Parameters].[Parameter 2]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.1dodda30jhn0yw198lkb41qh51xz].[none:medical_condition:nk]</rows>
        <cols>[federated.1dodda30jhn0yw198lkb41qh51xz].[usr:Calculation_1268881556082695:qk]</cols>
      </table>
